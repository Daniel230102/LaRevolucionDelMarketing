rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives & Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return request.auth.token.email_verified == true; }
    
    // Pillar 1: The Master Gate
    function isCompanyOwner(companyId) {
      return isSignedIn() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    // Pillar 2: Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'managedCompanies', 'createdAt'])
        && data.email is string && data.email.size() > 0 && data.email.size() < 256
        && data.managedCompanies is list
        && data.createdAt is string;
    }

    function isValidCompany(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 256
        && data.ownerId == request.auth.uid
        && data.createdAt is string;
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 256
        && data.companyId is string && isValidId(data.companyId);
    }

    function isValidLead(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 256
        && data.companyId is string && isValidId(data.companyId);
    }

    function isValidReport(data) {
      return data.action is string && data.category is string && data.timestamp is string;
    }

    // ---------------------------------------------------------
    // Phase 4: Match Blocks
    // ---------------------------------------------------------

    // User Profile (PII isolation)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
        && incoming().email == existing().email; // Email immutable
    }

    // Root Collection: Companies
    match /companies/{companyId} {
      // Create: Verify ID and data
      allow create: if isSignedIn() && isValidId(companyId) && isValidCompany(incoming());
      
      // Read: Force secure list queries (Pillar 8)
      allow get: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Update: Action-based updates (Pillar 4)
      allow update: if (
        isSignedIn() && existing().ownerId == request.auth.uid && isValidCompany(incoming()) &&
        incoming().ownerId == existing().ownerId && // Identity Integrity
        incoming().createdAt == existing().createdAt // Immutability
      );

      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      // --- Sub-collections ---

      match /products/{productId} {
        allow create: if isCompanyOwner(companyId) && isValidProduct(incoming());
        allow read: if isCompanyOwner(companyId);
        allow update: if isCompanyOwner(companyId) && isValidProduct(incoming())
          && incoming().companyId == existing().companyId;
        allow delete: if isCompanyOwner(companyId);
      }

      match /leads/{leadId} {
        allow create: if isCompanyOwner(companyId) && isValidLead(incoming());
        allow read: if isCompanyOwner(companyId);
        allow update: if isCompanyOwner(companyId) && isValidLead(incoming())
          && incoming().companyId == existing().companyId;
        allow delete: if isCompanyOwner(companyId);
      }

      match /competitors/{competitorId} {
        allow create, read, update, delete: if isCompanyOwner(companyId);
      }

      match /automations/{taskId} {
        allow create: if isCompanyOwner(companyId);
        allow read: if isCompanyOwner(companyId);
        allow update: if isCompanyOwner(companyId) && (
          // Action: Update status
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adaptation'])
        );
        allow delete: if isCompanyOwner(companyId);
      }

      match /reports/{reportId} {
        allow create: if isCompanyOwner(companyId) && isValidReport(incoming());
        allow read: if isCompanyOwner(companyId);
        allow update, delete: if false; // Pillar 9: Immutable
      }
    }
  }
}
